@inherits LayoutComponentBase

<div class="page">
    <header class="header">
        <div class="container header-inner">
            <a class="brand" href="." aria-label="PassGen, на главную">
                <svg class="brand-logo" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 21H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h14a3 3 0 0 1 3 3v3"/>
                    <path d="M7 12h.01M12 12h.01M17 12h.01"/>
                    <path d="m15 19 2.5 2.5L22 16"/>
                </svg>
                <h1>PassGen <span>генератор паролей</span></h1>
            </a>
            <ThemeToggle />
        </div>
    </header>

    <main class="container main">
        @Body
    </main>

    <footer class="container footer">
        <p class="privacy">
            <Icon Name="shield" Size="18" />
            Пароли создаются прямо в вашем браузере криптографически стойким генератором и никуда не отправляются.
        </p>
        <p class="footer-links">
            <a href="https://github.com/OneCodeUnit/PassGen/releases/latest" target="_blank" rel="noopener">
                <Icon Name="download" Size="16" /> Версия для Windows
            </a>
            <a href="https://github.com/OneCodeUnit/PassGen" target="_blank" rel="noopener">Исходный код на GitHub</a>
            <span class="muted">© OliveWizard</span>
        </p>
    </footer>
</div>
