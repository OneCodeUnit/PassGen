@* Пароль по символам: цифры и спецсимволы подсвечены, чтобы его было проще прочитать и переписать. *@
@if (Hidden)
{
    <span class="pw-hidden" aria-label="Пароль скрыт">@(new string('•', Value.Length))</span>
}
else
{
    foreach (var ch in Value)
    {
        <span class="@ClassOf(ch)">@ch</span>
    }
}

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public bool Hidden { get; set; }

    private static string ClassOf(char ch) =>
        char.IsAsciiDigit(ch) ? "pw-digit" : char.IsAsciiLetter(ch) ? "pw-letter" : "pw-symbol";
}
