# Пример настроек для docker-compose.yml.
# Скопируйте в .env (cp .env.example .env) и при необходимости измените значения.
# Все переменные необязательны: указаны значения по умолчанию.

# Образ контейнера (собирается GitHub Actions). Для закрепления версии: ghcr.io/onecodeunit/passgen:v1.0.0
PASSGEN_IMAGE=ghcr.io/onecodeunit/passgen:latest

# Внешняя docker-сеть обратного прокси (Caddy). Сеть должна уже существовать: docker network ls
CADDY_NETWORK=proxy

# Публикация порта на хосте. 127.0.0.1 - только с самого сервера;
# адрес в локальной сети (например, 192.168.1.101) - для прокси на другой машине.
PASSGEN_BIND=127.0.0.1
PASSGEN_PORT=8080
